<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A simple Node.js app rendered with EJS." />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="card">
        <div class="leftSide">
          <div class="workspace-frame" data-action-limit="10">
            <div class="blockMatt">
              <div class="workspace-canvas"></div>
            </div>
              <div class="actions-counter" aria-live="polite" aria-atomic="true">
                Actions: <span class="actions-used">0</span> / 10
              </div>
              <div class="remove">
                <img src="/icons/trash_can.png" width="20" height="20" alt="">
              </div>
              <div class="zoom-controls" role="group" aria-label="Workspace zoom">
                <button class="zoom-out" type="button" aria-label="Zoom out" title="Zoom out">−</button>
                <output class="zoom-level" aria-live="polite">100%</output>
                <button class="zoom-in" type="button" aria-label="Zoom in" title="Zoom in">+</button>
              </div>
          </div>
        </div>
      <% const blockGroups = blocks.reduce((groups, block) => {
            let group = groups.find((item) => item.type === block.type);
            if (!group) {
              group = { type: block.type, blocks: [] };
              groups.push(group);
            }
            group.blocks.push(block);
            return groups;
          }, []); %>
      <div class="palette-panel">
        <nav class="block-category-nav" aria-label="Block categories">
          <% blockGroups.forEach((group) => { %>
            <button class="category-nav-button <%= group.type %>" type="button"
              data-category="<%= group.type %>" aria-controls="blocks-<%= group.type %>">
              <span class="category-nav-dot" aria-hidden="true"></span>
              <span><%= group.type %></span>
            </button>
          <% }); %>
        </nav>
        <div class="blocksCont">
          <% blockGroups.forEach((group) => { %>
            <section id="blocks-<%= group.type %>" class="block-category" aria-labelledby="category-<%= group.type %>">
              <h2 id="category-<%= group.type %>" class="block-category-title"><%= group.type %></h2>
              <div class="block-category-items">
                <% group.blocks.forEach((block) => { %>
            <div class="block <%= block.type %> <%= block.name %>">
                <div class="block-header">
                <span class="ticks" aria-label="Cost: <%= block.cost %>">
                    <% for (let tick = 0; tick < block.cost; tick += 1) { %>
                    <span class="tick" aria-hidden="true">&bull;</span>
                    <% } %>
                </span>
                <% if (block.type === 'operator') { %>
                <div class="variable-input operand-input" role="group" aria-label="Left value for <%= block.name %>"></div>
                <span class="operator-symbol" aria-label="<%= block.name %>"><%= block.name %></span>
                <div class="variable-input operand-input" role="group" aria-label="Right value for <%= block.name %>"></div>
                <% } else { %>
                <div><%= block.name %></div>
                <% } %>
                <select class="dropdown" style="display: <%= block.dropdown ? 'flex' : 'none' %>">
                  <option value="left">90</option>
                  <option value="right">-90</option>
                  <option value="180">180</option>
                </select>
                <% if (block.name === 'if' || block.name === 'wait until' || block.name === 'repeat until') { %>
                <div class="variable-input expression-input" role="group" aria-label="Drop a variable or operator into the if condition"></div>
                <% } else { %>
                <input type="text" inputmode="numeric" pattern="[0-9]*" aria-label="<%= block.name %> <%= block.follower %>" style="display: <%= block.input ? 'flex' : 'none' %>">
                <% } %>
                <div><%= block.follower %></div>
                </div>
                <% if (block.type === 'wrap') { %>
                <div class="wrap-contents" aria-label="Blocks inside <%= block.name %>"></div>
                <% } %>
            </div>
              <% }); %>
            </div>
          </section>
        <% }); %>
      </div>
      </div>
    </main>
  </body>
  <script src="/blocking.js"></script>
</html>
