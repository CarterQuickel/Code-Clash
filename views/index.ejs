<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A simple Node.js app rendered with EJS." />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="card">
        <div class="leftSide">
          <div class="workspace-frame" data-action-limit="10">
            <div class="blockMatt">
              <div class="workspace-canvas"></div>
            </div>
              <div class="actions-counter" aria-live="polite" aria-atomic="true">
                Actions: <span class="actions-used">0</span> / <span class="actions-limit">10</span>
              </div>
              <div class="remove">
                <img src="/icons/trash_can.png" width="20" height="20" alt="">
              </div>
              <div class="zoom-controls" role="group" aria-label="Workspace zoom">
                <button class="zoom-out" type="button" aria-label="Zoom out" title="Zoom out">
                  <img class="zoomIMG" src="/icons/zoom_out.png" width="20" height="20">
                </button>
                <output class="zoom-level" aria-live="polite">100%</output>
                <button class="zoom-in" type="button" aria-label="Zoom in" title="Zoom in">
                  <img class="zoomIMG" src="/icons/zoom_in.png" width="20" height="20">
                </button>
              </div>
              <aside class="arena-minimap" aria-label="Arena minimap preview">
                <span class="minimap-label">PREVIEW</span>
                <canvas class="minimap-canvas" width="180" height="104" aria-hidden="true"></canvas>
              </aside>
              <div class="editor-controls">
                <span class="round-label">Round <strong class="round-number">1</strong> of 3</span>
                <button class="play-match" type="button" disabled>
                  <img src="/icons/play_flag.png" width="20" height="20"> 
                </button>
                <p class="game-message" aria-live="polite">Choose a game mode to begin building your program.</p>
              </div>
              <section class="game-setup" aria-labelledby="setup-title">
                <div class="setup-card">
                  <div id="setup-title" class="mainTitle block">crank your tank</div>
                  <div id="setup-title" class="credit block">by 
                    <div class="block variable">carter quickel</div>
                  </div>
                  <button class="mode-choice block" type="button" data-mode="solo">single player</button>
                  <button class="mode-choice block" type="button" data-mode="duel">local 2-player</button>
                </div>
              </section>
              <section class="arena-screen" hidden aria-label="Tank match">
                <header class="arena-header">
                  <div class="tank-score"><span class="score-name">PLAYER 1</span><strong class="p1-health">3</strong><span>❤</span><span class="match-actions">Actions <strong class="p1-actions">10</strong></span></div>
                  <div class="arena-round">ROUND <strong class="arena-round-number">1</strong> / 3</div>
                  <div class="tank-score right"><span class="score-name opponent-name">CPU</span><strong class="p2-health">3</strong><span>❤</span><span class="match-actions">Actions <strong class="p2-actions">10</strong></span></div>
                </header>
                <div class="arena-main">
                  <section class="code-playback player-one-playback" aria-label="Player 1 program">
                    <h2>Player 1 code</h2>
                    <div class="code-lines"></div>
                  </section>
                  <canvas class="arena-canvas" width="900" height="520" aria-label="Tank arena"></canvas>
                  <section class="code-playback player-two-playback" aria-label="Player 2 program">
                    <h2>Player 2 code</h2>
                    <div class="code-lines"></div>
                  </section>
                </div>
                <footer class="arena-footer">
                  <p class="arena-status" aria-live="polite">Ready</p>
                  <button class="next-round" type="button" hidden>Next round (+3 actions)</button>
                  <button class="back-to-code" type="button" hidden>Edit code</button>
                </footer>
              </section>
          </div>
        </div>
      <% const blockGroups = blocks.reduce((groups, block) => {
            let group = groups.find((item) => item.type === block.type);
            if (!group) {
              group = { type: block.type, blocks: [] };
              groups.push(group);
            }
            group.blocks.push(block);
            return groups;
          }, []); %>
      <div class="palette-panel">
        <div class="player-tabs" role="tablist" aria-label="Player programs">
          <button class="player-tab is-active" type="button" role="tab" aria-selected="true" data-player="0">Player 1</button>
          <button class="player-tab" type="button" role="tab" aria-selected="false" data-player="1" hidden>Player 2</button>
        </div>
        <nav class="block-category-nav" aria-label="Block categories">
          <% blockGroups.forEach((group) => { %>
            <button class="category-nav-button <%= group.type %>" type="button"
              data-category="<%= group.type %>" aria-controls="blocks-<%= group.type %>">
              <span class="category-nav-dot" aria-hidden="true"></span>
              <span><%= group.type %></span>
            </button>
          <% }); %>
        </nav>
        <div class="blocksCont">
          <% blockGroups.forEach((group) => { %>
            <section id="blocks-<%= group.type %>" class="block-category" aria-labelledby="category-<%= group.type %>">
              <h2 id="category-<%= group.type %>" class="block-category-title"><%= group.type %></h2>
              <div class="block-category-items">
                <% group.blocks.forEach((block) => { %>
            <div class="block <%= block.type %> <%= block.name %>" data-block-name="<%= block.name %>" data-block-type="<%= block.type %>" data-cost="<%= block.cost %>" data-wrap-kind="<%= block.name === 'repeat' || block.name === 'repeat until' ? block.name : '' %>">
                <div class="block-header">
                <span class="ticks" aria-label="Cost: <%= block.cost %>">
                    <% for (let tick = 0; tick < block.cost; tick += 1) { %>
                    <span class="tick" aria-hidden="true">&bull;</span>
                    <% } %>
                </span>
                <% if (block.type === 'operator') { %>
                <div class="variable-input operand-input" role="group" aria-label="Left value for <%= block.name %>"></div>
                <span class="operator-symbol" aria-label="<%= block.name %>"><%= block.name %></span>
                <div class="variable-input operand-input" role="group" aria-label="Right value for <%= block.name %>"></div>
                <% } else { %>
                <div><%= block.name %></div>
                <% } %>
                <select class="dropdown" style="display: <%= block.dropdown ? 'flex' : 'none' %>">
                  <option value="left">90</option>
                  <option value="right">-90</option>
                  <option value="180">180</option>
                </select>
                <% if (block.name === 'if' || block.name === 'wait until' || block.name === 'repeat until') { %>
                <div class="variable-input expression-input" role="group" aria-label="Drop a variable or operator into the if condition"></div>
                <% } else { %>
                <input type="text" inputmode="numeric" pattern="[0-9]*" aria-label="<%= block.name %> <%= block.follower %>" style="display: <%= block.input ? 'flex' : 'none' %>">
                <% } %>
                <div><%= block.follower %></div>
                </div>
                <% if (block.type === 'wrap') { %>
                <div class="wrap-contents" aria-label="Blocks inside <%= block.name %>"></div>
                <% } %>
            </div>
              <% }); %>
            </div>
          </section>
        <% }); %>
      </div>
      </div>
    </main>
  </body>
  <script src="/blocking.js"></script>
  <script src="/game.js"></script>
</html>
